{
  "name": "@qiu-creator/mac-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "CREATORHUB_REQUIRE_HOME=1 tsx watch src/main.ts",
    "start": "node --import tsx src/main.ts",
    "asset:register": "tsx scripts/register-asset.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.4",
    "@qiu-creator/contracts": "workspace:*",
    "@qiu-creator/domain": "workspace:*",
    "better-sqlite3": "^13.2.0",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@qiu-creator/api-client": "workspace:*",
    "@types/better-sqlite3": "^9.6.0"
  }
}
