{
  "name": "@qiu-creator/mac-server",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "dev": "CREATORHUB_REQUIRE_HOME=1 tsx watch src/main.ts",
    "start": "node --import tsx src/main.ts",
    "build": "tsx scripts/build.ts",
    "start:dist": "dist/bin/node dist/server.mjs",
    "asset:register": "tsx scripts/register-asset.ts",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.9.0",
    "@fastify/swagger": "^9.9.3",
    "@fastify/swagger-ui": "^6.1.4",
    "@google/genai": "^3.4.0",
    "@napi-rs/keyring": "^2.1.2",
    "@qiu-creator/contracts": "workspace:*",
    "@qiu-creator/domain": "workspace:*",
    "@qiu-creator/platform-preview": "workspace:*",
    "@tus/file-store": "^2.1.2",
    "@tus/server": "^2.4.7",
    "better-sqlite3": "^13.2.0",
    "chokidar": "^6.0.0",
    "fastify": "^5.12.8",
    "fastify-type-provider-zod": "^7.0.0",
    "file-type": "^22.3.0",
    "mdast-util-from-markdown": "^2.1.0",
    "mdast-util-frontmatter": "^2.0.1",
    "mdast-util-gfm": "^3.1.0",
    "micromark-extension-frontmatter": "^2.0.0",
    "micromark-extension-gfm": "^3.0.0",
    "openai": "^7.57.0",
    "sharp": "^0.35.5",
    "tsx": "^4.23.15",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@qiu-creator/api-client": "workspace:*",
    "@types/better-sqlite3": "^9.6.0",
    "@types/mdast": "^4.0.4",
    "esbuild": "0.28.2"
  }
