{
  "name": "@qiu-creator/mac",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.cjs",
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "vite build && node scripts/build-electron.mjs",
    "start": "electron .",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "package": "vite build && node scripts/build-electron.mjs && electron-builder --config electron-builder.yml --mac dir --arm64"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@fontsource-variable/inter": "^5.3.0",
    "@qiu-creator/api-client": "workspace:*",
    "@qiu-creator/contracts": "workspace:*",
    "@qiu-creator/design-tokens": "workspace:*",
    "@qiu-creator/domain": "workspace:*",
    "@qiu-creator/i18n": "workspace:*",
    "@qiu-creator/markdown-editor-web": "workspace:*",
    "@qiu-creator/platform-preview": "workspace:*",
    "motion": "^14.14.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@qiu-creator/mac-server": "workspace:*",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "electron": "^45.3.2",
    "electron-builder": "26.18.0",
    "esbuild": "^0.28.2",
    "vite": "^8.3.8"
  },
  "description": "qiu-creator Mac app",
  "author": "qiuge"
}
