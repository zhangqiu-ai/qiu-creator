<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!--
  Template only. Replace every __PLACEHOLDER__ before installing; see
  deploy/launchd/README.md. Do not load this file as-is.
  Runs the installed build artifact (QC-030), not the repository.
-->
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.qiu-creator.mac-server</string>

  <key>ProgramArguments</key>
  <array>
    <!-- The Node binary shipped inside the artifact, matching its native modules. -->
    <string>__USER_HOME__/Library/Application Support/qiu-creator/server/bin/node</string>
    <string>__USER_HOME__/Library/Application Support/qiu-creator/server/server.mjs</string>
  </array>

  <key>WorkingDirectory</key>
  <string>__USER_HOME__/Library/Application Support/qiu-creator/server</string>

  <key>EnvironmentVariables</key>
  <dict>
    <key>CREATORHUB_HOME</key>
    <string>__USER_HOME__/CreatorHub</string>
    <key>CREATORHUB_HOST</key>
    <string>127.0.0.1</string>
    <key>CREATORHUB_PORT</key>
    <string>7420</string>
    <!-- Logs: the service rotates this file at 10 MB and keeps 5 old ones (≈ 60 MB at most). -->
    <key>CREATORHUB_LOG_FILE</key>
    <string>__USER_HOME__/Library/Logs/qiu-creator/mac-server.log</string>
    <key>CREATORHUB_LOG_MAX_BYTES</key>
    <string>10485760</string>
    <!-- Only what escapes the logger lands here; emptied at start once it passes the cap. -->
    <key>CREATORHUB_STDERR_FILE</key>
    <string>__USER_HOME__/Library/Logs/qiu-creator/mac-server.err.log</string>
    <key>NODE_ENV</key>
    <string>production</string>
  </dict>

  <!-- Start at login and restart after crashes; Electron is not involved. -->
  <key>RunAtLoad</key>
  <true/>
  <key>KeepAlive</key>
  <true/>
  <key>ThrottleInterval</key>
  <integer>10</integer>
  <key>ProcessType</key>
  <string>Standard</string>

  <key>StandardOutPath</key>
  <string>__USER_HOME__/Library/Logs/qiu-creator/mac-server.err.log</string>
  <key>StandardErrorPath</key>
  <string>__USER_HOME__/Library/Logs/qiu-creator/mac-server.err.log</string>
</dict>
</plist>
